class SuperUser(User):
    
    count = 0

    def __init__(self, name, login, password, role, level):
        SuperUser.count += 1
       
        super().__init__(name, login, password, level)
        self._role = role

    @property
    def role(self):
        return self._role

    @role.setter
    def role(self, value):
        self._role = value

    def show_info(self):
        
        super().show_info()

    def __setattr__(self, name, value):
        if name.startswith('_'):
            object.__setattr__(self, name, value)
        elif name == 'role':
            self._role = value
        else:
            super().__setattr__(name, value)
